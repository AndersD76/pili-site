generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============ ENUMS ============

enum Role {
  ADMIN
  COMERCIAL
  TECNICO
  CLIENTE
}

enum LeadStatus {
  NOVO
  QUALIFICADO
  CONTATADO
  PROPOSTA
  GANHO
  PERDIDO
}

enum LeadSource {
  ORGANICO
  PAGO
  REFERRAL
  WHATSAPP
  CATALOGO
  CALCULADORA
  COMPARATIVO
  FORMULARIO
  TRABALHE_CONOSCO
}

/// Categoria editorial do artigo, usada no filtro do blog.
enum PostCategory {
  noticia
  artigo
  evento
  lancamento
}

enum ProductCategory {
  TOMBADOR_FIXO
  TOMBADOR_MOVEL
  COLETOR_AMOSTRAS
  UNIDADE_TRANSBORDO
  ESPECIAL
}

enum Locale {
  pt_BR @map("pt-BR")
  en
  es
}

// ============ AUTH ============

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String            @unique
  emailVerified DateTime? @db.Timestamptz(3)
  /// Senha provisória que o usuário ainda não trocou.
  ///
  /// Contas criadas em lote pelo sync do CRM nascem com senha gerada por nós.
  /// Enquanto isto for `true` o portal só mostra a tela de troca — sem isso a
  /// senha provisória vira definitiva e vale para sempre.
  mustChangePassword Boolean @default(false)
  image         String?
  passwordHash  String?
  role          Role              @default(CLIENTE)
  company       String?
  phone         String?
  cpfCnpj       String?
  accounts      Account[]
  sessions      Session[]
  notes         Note[]
  equipment     ClientEquipment[]
  maintenance   MaintenanceRequest[]
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
}

// ============ PRODUTOS ============

model Product {
  id           String               @id @default(cuid())
  slug         String               @unique
  category     ProductCategory
  order        Int                  @default(0)
  active       Boolean              @default(true)
  featured     Boolean              @default(false)
  translations ProductTranslation[]
  specs        Spec[]
  features     Feature[]
  media        Media[]
  faqs         FAQ[]
  applications Application[]        @relation("ProductApplications")
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)
}

model ProductTranslation {
  id          String  @id @default(cuid())
  productId   String
  locale      Locale
  name        String
  tagline     String?
  description String  @db.Text
  metaTitle   String?
  metaDesc    String?
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
}

model Spec {
  id        String  @id @default(cuid())
  productId String
  key       String
  value     String
  order     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Feature {
  id          String  @id @default(cuid())
  productId   String
  locale      Locale
  title       String
  description String  @db.Text
  icon        String?
  order       Int     @default(0)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model FAQ {
  id        String   @id @default(cuid())
  productId String?
  locale    Locale
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Application {
  id           String                   @id @default(cuid())
  slug         String                   @unique
  translations ApplicationTranslation[]
  products     Product[]                @relation("ProductApplications")
  cases        Case[]
}

model ApplicationTranslation {
  id            String      @id @default(cuid())
  applicationId String
  locale        Locale
  name          String
  description   String      @db.Text
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, locale])
}

// ============ MEDIA ============

/// Arquivo de midia com os bytes no proprio banco.
///
/// O volume do site e pequeno (dezenas de fotos) e nao justifica contratar
/// armazenamento externo. A entrega passa por `GET /api/media/[id]`, que envia
/// `Cache-Control: immutable` — o id nunca muda para o mesmo arquivo, entao o
/// CDN e o navegador guardam indefinidamente e o banco e lido uma vez so.
model Media {
  id          String  @id @default(cuid())
  productId   String?
  caseId      String?
  postId      String?
  heroSlideId String?
  setorSlug   String?
  blocoChave  String?
  /// Conteudo binario do arquivo.
  data      Bytes
  filename  String
  mimeType  String
  /// Tamanho em bytes, para exibir na biblioteca sem carregar o binario.
  size      Int
  alt       String?
  type      String   @default("image")
  width     Int?
  height    Int?
  order     Int      @default(0)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  case      Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  heroSlide HeroSlide? @relation(fields: [heroSlideId], references: [id], onDelete: Cascade)
  setor     Setor?     @relation(fields: [setorSlug], references: [slug], onDelete: Cascade)
  bloco     BlocoConteudo? @relation(fields: [blocoChave], references: [chave], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([productId])
  @@index([caseId])
  @@index([postId])
  @@index([heroSlideId])
  @@index([setorSlug])
  @@index([blocoChave])
}

// ============ CASES / OBRAS ============

model Case {
  id            String            @id @default(cuid())
  slug          String            @unique
  applicationId String?
  client        String
  location      String
  year          Int
  active        Boolean           @default(true)
  featured      Boolean           @default(false)
  translations  CaseTranslation[]
  media         Media[]
  metrics       CaseMetric[]
  application   Application?      @relation(fields: [applicationId], references: [id])
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
}

model CaseTranslation {
  id      String @id @default(cuid())
  caseId  String
  locale  Locale
  title   String
  summary String @db.Text
  content String @db.Text
  case    Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, locale])
}

model CaseMetric {
  id     String @id @default(cuid())
  caseId String
  label  String
  value  String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

// ============ BLOG ============

model Post {
  id           String            @id @default(cuid())
  slug         String            @unique
  author       String            @default("PILI Industrial")
  category     PostCategory      @default(artigo)
  /// Tempo estimado de leitura em minutos.
  readTime     Int               @default(5)
  cover        String?
  published    Boolean           @default(false)
  publishedAt  DateTime? @db.Timestamptz(3)
  translations PostTranslation[]
  media        Media[]
  tags         String[]          @default([])
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
}

model PostTranslation {
  id        String @id @default(cuid())
  postId    String
  locale    Locale
  title     String
  excerpt   String @db.Text
  content   String @db.Text
  metaTitle String?
  metaDesc  String?
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
}

// ============ LEADS ============

model Lead {
  id              String     @id @default(cuid())
  name            String
  email           String
  // Opcional: os gates de catálogo e calculadora convertem só com e-mail.
  phone           String?
  company         String?
  cnpj            String?
  country         String     @default("BR")
  state           String?
  city            String?
  role            String?
  application     String?
  productId       String?
  productInterest String?
  grainType       String?
  truckVolume     Int?
  message         String?    @db.Text
  source          LeadSource @default(FORMULARIO)
  utm             Json?
  pageUrl         String?
  status          LeadStatus @default(NOVO)
  assignedTo      String?
  notes           Note[]
  consentAt       DateTime? @db.Timestamptz(3)
  anonymizedAt    DateTime? @db.Timestamptz(3)
  deletedAt       DateTime? @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)

  @@index([deletedAt, createdAt])
  @@index([status])
  @@index([source])
}

model Note {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([leadId])
  @@index([authorId])
}

// ============ JOB POSTINGS ============

model Job {
  id           String           @id @default(cuid())
  slug         String           @unique
  active       Boolean          @default(true)
  translations JobTranslation[]
  applications JobApplication[]
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
}

model JobTranslation {
  id          String @id @default(cuid())
  jobId       String
  locale      Locale
  title       String
  area        String
  description String @db.Text
  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, locale])
}

/// Candidatura enviada pelo formulário de "Trabalhe conosco".
///
/// `jobId` é opcional: o site não publica vagas, o formulário alimenta um
/// banco de talentos. Antes as candidaturas eram gravadas como `Lead` com
/// `company: "Candidato"` e a área concatenada dentro da mensagem — apareciam
/// misturadas ao funil comercial e o currículo não tinha onde ficar.
model JobApplication {
  id         String    @id @default(cuid())
  jobId      String?
  name       String
  email      String
  phone      String
  /// Área de interesse; chave de `trabalhe.areas` nas mensagens.
  area       String
  message    String?   @db.Text
  /// Currículo guardado no próprio banco, como as fotos. Servido só para o
  /// admin autenticado — é dado pessoal, não pode ficar em URL pública.
  cvData     Bytes?
  cvFilename String?
  cvMimeType String?
  cvSize     Int?
  /// Consentimento LGPD registrado no envio.
  consentAt  DateTime? @db.Timestamptz(3)
  reviewedAt DateTime? @db.Timestamptz(3)
  deletedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  job        Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([deletedAt, createdAt])
  @@index([area])
}

// ============ PORTAL CLIENTE ============

model ClientEquipment {
  id               String         @id @default(cuid())
  userId           String
  serialNumber     String         @unique
  productName      String
  /// Nulo quando a data não é conhecida. O CRM tem o equipamento vendido, mas
  /// nem sempre a data de instalação — gravar "hoje" nesse caso seria inventar
  /// um dado que o cliente veria como verdadeiro na ficha dele.
  installedAt      DateTime? @db.Timestamptz(3)
  installedAddress String?
  warrantyEndsAt   DateTime? @db.Timestamptz(3)
  /// Solicitações de manutenção abertas pelo cliente no portal.
  maintenance      MaintenanceRequest[]
  documents        EquipmentDocument[]
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

enum DocumentType {
  CIVIL
  ELETRICO
  HIDRAULICO
  MANUAL
  CERTIFICADO
  LAUDO
}

model EquipmentDocument {
  id          String          @id @default(cuid())
  equipmentId String
  type        DocumentType
  title       String
  filename    String
  data        Bytes
  mimeType    String
  size        Int
  equipment   ClientEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  @@index([equipmentId])
}

/// Motivo do chamado.
enum MaintenanceType {
  CORRETIVA
  PREVENTIVA
  INSTALACAO
  DUVIDA_TECNICA
  OUTRO
}

/// Urgência declarada pelo cliente. `PARADA` significa equipamento fora de
/// operação — é o caso que a equipe precisa ver primeiro.
enum MaintenanceUrgency {
  BAIXA
  MEDIA
  ALTA
  PARADA
}

enum MaintenanceStatus {
  ABERTA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

/// Solicitação de manutenção aberta pelo cliente no portal.
///
/// Não é a ordem de serviço: a OS vive no ERP da PILI. Aqui fica apenas o
/// chamado — o pedido que o cliente registra e que o comercial transforma em
/// OS do lado de lá.
model MaintenanceRequest {
  id          String             @id @default(cuid())
  /// Número sequencial legível, para o cliente citar por telefone.
  number      Int                @unique @default(autoincrement())
  equipmentId String
  userId      String
  type        MaintenanceType
  urgency     MaintenanceUrgency
  status      MaintenanceStatus  @default(ABERTA)
  description String             @db.Text
  contactName  String
  contactPhone String
  /// Anotação interna da equipe; não aparece para o cliente.
  internalNote String?           @db.Text
  /// Quando o aviso ao comercial saiu. Nulo enquanto não houver transporte de
  /// e-mail configurado — assim os chamados pendentes podem ser notificados
  /// em lote depois, sem perder nenhum.
  notifiedAt  DateTime?          @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)
  equipment   ClientEquipment    @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([equipmentId])
  @@index([notifiedAt])
}

// ============ RATE LIMITING ============

/// Contador de janela fixa para limitar requisições.
///
/// Substitui o Redis externo: o volume do site não justifica outro serviço, e o
/// Postgres já está aqui. O incremento é feito em um único `INSERT ... ON
/// CONFLICT`, que é atômico — duas requisições simultâneas não perdem contagem.
model RateLimit {
  /// Ex.: `leads:203.0.113.7`, `login:email:joao@exemplo.com`.
  key       String   @id
  count     Int      @default(1)
  /// Fim da janela; passado esse instante o contador reinicia.
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

// ============ CONFIGURACOES DO SITE ============

/// Dados institucionais editaveis pelo painel.
///
/// Antes viviam em `src/lib/constants.ts` — mudar telefone ou e-mail exigia
/// deploy. Linha unica, fixada em `id = "default"`.
model SiteSettings {
  id             String   @id @default("default")
  razaoSocial    String
  cnpj           String
  endereco       String
  telefone       String
  whatsapp       String
  email          String
  emailComercial String
  fundacao       Int
  instagram      String?
  linkedin       String?
  facebook       String?
  youtube        String?
  piliTechUrl    String?
  /// Coordenadas do mapa na pagina de contato. Sem elas o bloco nao e exibido.
  mapaLat        Float?
  mapaLng        Float?
  mapaZoom       Int      @default(15)
  /// Numeros da faixa de destaque e do topo da home.
  ///
  /// Texto livre porque o site exibe "850+" e "100t" — o "+" e a unidade fazem
  /// parte do numero. Anos de mercado nao entram aqui: sao calculados a partir
  /// de `fundacao`, senao ficariam desatualizados na virada do ano.
  statsEquipamentos String @default("850+")
  statsPaises       Int    @default(18)
  statsCapacidade   String @default("100t")
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
}


// ============ LINHA DO TEMPO DA EMPRESA ============

/// Marco da trajetoria exibido em /empresa.
///
/// O ano e texto, nao numero: o ultimo marco e "Hoje", que nao tem ano.
/// Sem nenhum marco cadastrado a pagina usa a linha do tempo das mensagens.
model MarcoHistoria {
  id           String                     @id @default(cuid())
  ano          String?
  ordem        Int                        @default(0)
  ativo        Boolean                    @default(true)
  translations MarcoHistoriaTranslation[]
  createdAt    DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                   @updatedAt @db.Timestamptz(3)

  @@index([ativo, ordem])
}

model MarcoHistoriaTranslation {
  id      String        @id @default(cuid())
  marcoId String
  locale  Locale
  titulo  String
  texto   String        @db.Text
  marco   MarcoHistoria @relation(fields: [marcoId], references: [id], onDelete: Cascade)

  @@unique([marcoId, locale])
}

// ============ BLOCOS DE CONTEUDO ============

/// Bloco de secao com imagem e texto editaveis.
///
/// Generico de proposito: a chave identifica a secao ("ecossistema"), e a
/// mesma tabela serve para os proximos blocos sem uma tabela por secao.
/// Campo vazio significa "usar o texto das mensagens".
model BlocoConteudo {
  chave        String                     @id
  ativo        Boolean                    @default(true)
  media        Media[]
  translations BlocoConteudoTranslation[]
  createdAt    DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                   @updatedAt @db.Timestamptz(3)
}

model BlocoConteudoTranslation {
  id        String        @id @default(cuid())
  chave     String
  locale    Locale
  titulo    String?
  subtitulo String?
  texto     String?       @db.Text
  bloco     BlocoConteudo @relation(fields: [chave], references: [chave], onDelete: Cascade)

  @@unique([chave, locale])
}

// ============ SETORES DE APLICACAO ============

/// Cartao de "Solucoes por setor" na home.
///
/// O slug e a chave primaria de proposito: ele casa com a rota
/// /solucoes/[setor], que tem um conjunto fixo de cinco paginas. Por isso o
/// painel edita os setores existentes e nao cria novos — um setor inventado
/// aqui viraria um card apontando para 404.
///
/// Sem tradução cadastrada o site usa o texto das mensagens; sem imagem, a
/// foto padrao. Editar e opcional, nao obrigatorio.
model Setor {
  slug         String             @id
  ordem        Int                @default(0)
  ativo        Boolean            @default(true)
  media        Media[]
  translations SetorTranslation[]
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)

  @@index([ativo, ordem])
}

model SetorTranslation {
  id        String @id @default(cuid())
  setorSlug String
  locale    Locale
  /// Titulo e descricao curtos do card da home.
  titulo    String
  descricao String
  /// Textos da pagina /solucoes/[setor]. Vazios, a pagina usa as mensagens.
  headline       String?
  descricaoLonga String? @db.Text
  setor     Setor  @relation(fields: [setorSlug], references: [slug], onDelete: Cascade)

  @@unique([setorSlug, locale])
}

// ============ CARROSSEL DA HOME ============

/// Slide do fundo do hero na home.
///
/// A imagem vem da biblioteca de midia, pelo mesmo `MediaUploader` de produtos,
/// obras e artigos: a primeira foto da lista e o fundo do slide.
///
/// Sem nenhum slide ativo a home cai no fundo estatico e no titulo das
/// mensagens — o hero nunca fica vazio.
model HeroSlide {
  id           String                 @id @default(cuid())
  ordem        Int                    @default(0)
  ativo        Boolean                @default(true)
  media        Media[]
  translations HeroSlideTranslation[]
  createdAt    DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @db.Timestamptz(3)

  @@index([ativo, ordem])
}

/// Titulo e subtitulo do slide, por idioma.
///
/// O site e bilingue: sem traducao o visitante espanhol leria o titulo em
/// portugues.
model HeroSlideTranslation {
  id        String    @id @default(cuid())
  slideId   String
  locale    Locale
  titulo    String
  subtitulo String?
  slide     HeroSlide @relation(fields: [slideId], references: [id], onDelete: Cascade)

  @@unique([slideId, locale])
}

enum FilialTipo {
  FILIAL
  ESCRITORIO
  ASSISTENCIA
}

/// Unidades alem da matriz.
///
/// A matriz continua vindo de `SiteSettings`: repetir o endereco dela aqui
/// criaria duas fontes para o mesmo dado, que e exatamente como ele desanda.
/// Sem `lat`/`lng` a unidade ainda aparece como endereco, so nao entra no mapa.
model Filial {
  id        String     @id @default(cuid())
  nome      String
  tipo      FilialTipo @default(FILIAL)
  cidade    String
  uf        String
  endereco  String
  cep       String?
  telefone  String?
  lat       Float?
  lng       Float?
  /// Ordem de exibicao no rodape; empate cai para a cidade.
  ordem     Int        @default(0)
  ativa     Boolean    @default(true)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)

  @@index([ativa, ordem])
}
