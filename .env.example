# Database (NeonDB)
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="https://pili.ind.br"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email (Resend) — opcional; sem a chave os leads sao gravados mas
# nenhum e-mail de notificacao e enviado.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="contato@pili.ind.br"
LEAD_NOTIFY_EMAIL="comercial@pili.ind.br"
# Destino dos chamados de manutencao abertos no portal do cliente.
MAINTENANCE_NOTIFY_EMAIL="comercial1@pili.ind.br"

# Rate limiting usa a tabela `RateLimit` no proprio Postgres.
# Nao ha servico externo a configurar.

# Analytics
NEXT_PUBLIC_GA_ID="G-..."
NEXT_PUBLIC_META_PIXEL_ID=""

# Site
NEXT_PUBLIC_SITE_URL="https://pili.ind.br"

# Seed de usuários (obrigatório para `pnpm db:seed`; nunca use em produção)
# ALLOW_PROD_SEED=1 libera o seed quando NODE_ENV=production (use com cuidado)
SEED_ADMIN_NAME=""
SEED_CLIENT_NAME=""
SEED_ADMIN_EMAIL="admin@pili.ind.br"
SEED_ADMIN_PASSWORD=""
SEED_CLIENT_EMAIL="cliente@pili.ind.br"
SEED_CLIENT_PASSWORD=""

# Sync de clientes do Portal Pili (usado por scripts/sync-clientes-portal.mjs)
PORTAL_PILI_DB_URL="postgresql://..."

# Webhook: tickets de manutenção do site → Portal Pili.
# Sem as duas variáveis o chamado é gravado normalmente e fica pendente de
# entrega, com reenvio disponível em /admin/manutencao.
# O secret precisa ser idêntico ao configurado no Portal.
PORTAL_PILI_WEBHOOK_URL=""
PORTAL_PILI_WEBHOOK_SECRET=""

# Ecosystem URLs
PILI_STORE_URL="https://store.pili.ind.br"
PILI_TECH_URL="https://tech.pili.ind.br"
PILI_RASTE_URL="https://raste.pili.ind.br"
PILI_HARBOR_URL="https://harbor.pili.ind.br"

# Traducao automatica PT->ES no painel admin.
# Sem esta chave o botao "Traduzir do portugues" aparece desabilitado —
# o site continua funcionando normalmente, so nao gera o rascunho em espanhol.
ANTHROPIC_API_KEY=""
