# Database (NeonDB)
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="https://pili.ind.br"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="contato@pili.ind.br"
LEAD_NOTIFY_EMAIL="comercial@pili.ind.br"

# Rate Limiting (Upstash)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Analytics
NEXT_PUBLIC_GA_ID="G-..."
NEXT_PUBLIC_META_PIXEL_ID=""

# Site
NEXT_PUBLIC_SITE_URL="https://pili.ind.br"

# Seed de usuários (obrigatório para `pnpm db:seed`; nunca use em produção)
# ALLOW_PROD_SEED=1 libera o seed quando NODE_ENV=production (use com cuidado)
SEED_ADMIN_NAME=""
SEED_CLIENT_NAME=""
SEED_ADMIN_EMAIL="admin@pili.ind.br"
SEED_ADMIN_PASSWORD=""
SEED_CLIENT_EMAIL="cliente@pili.ind.br"
SEED_CLIENT_PASSWORD=""

# Ecosystem URLs
