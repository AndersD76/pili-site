# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Senhas temporarias dos clientes, geradas por scripts/sync-clientes-portal.mjs.
# O arquivo sai em texto puro; nao pode entrar no repositorio.
scripts/credenciais-clientes.csv
scripts/clientes-sem-email.csv

# Fotos originais da fabrica: 4000x6000, ~3MB cada. Nao entram no repositorio
# nem no deploy — o site serve as derivadas otimizadas de public/images/blog/,
# que sao versionadas normalmente. Guarde os originais fora do projeto.
/public/images/economizador de energia/
/public/images/engenharia/
/public/images/história/
/public/images/pessoas/
